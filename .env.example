# ─────────────────────────────────────────────────────────────────────────────
# Grape × Shopify integration — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# --- App runtime ---
NODE_ENV=development
PORT=3000
# Public base URL Shopify redirects back to (OAuth callback + webhook delivery).
APP_URL=https://localhost:3000

# --- Shopify app credentials (single public, unlisted app for all merchants) ---
# From the Shopify Partner dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Scopes per spec §4.2 — read-only catalogue + inventory write. NO order scopes.
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory,read_locations
# Admin API version (pin explicitly; bump deliberately).
SHOPIFY_API_VERSION=2026-04

# --- Encryption (access tokens are encrypted at rest, spec §4.3) ---
# 32-byte key, hex-encoded (e.g. `openssl rand -hex 32`).
TOKEN_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgres://localhost:5432/grape_shopify

# --- Safety layer (spec §6 Phase 4) ---
# Units held back so we never sell Shopify's last unit (spec §5.2 / §6 step 17).
OVERSELL_BUFFER_DEFAULT=2
# Cron expression for the nightly reconcile job (spec §6 step 16).
RECONCILE_CRON=0 3 * * *
# Where drift alerts are sent (e.g. a Slack webhook URL or ops email).
DRIFT_ALERT_DESTINATION=
