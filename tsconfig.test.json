{
  // Typecheck-only config for tests. Tests import with explicit `.ts` extensions
  // because they run under Node's native test runner (--experimental-strip-types),
  // which resolves the real files — not the emitted `.js`. So this config allows
  // `.ts` import specifiers and never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
