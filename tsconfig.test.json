{
  // Compiles src + tests to `dist-test/` and the suite runs the emitted JS via
  // Node's test runner. This keeps tests production-faithful: the same `.js`
  // import specifiers and ESM resolution as the real build, no runtime type
  // stripping. The production `build` (tsconfig.json) excludes tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-test"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-test"]
}
